+test "link-url-modifier defaults and exact matching" {
+    const testing = std.testing;
+    var cfg = try Config.default(testing.allocator);
+    defer cfg.deinit();
+    try testing.expectEqual(LinkUrlModifier.platform, cfg.@"link-url-modifier");
+    try testing.expect(LinkUrlModifier.platform.mods().equal(inputpkg.ctrlOrSuper(.{})));
+    try testing.expect(LinkUrlModifier.ctrl.mods().equal(.{ .ctrl = true }));
+    try testing.expect(LinkUrlModifier.super.mods().equal(.{ .super = true }));
+    try testing.expect(!LinkUrlModifier.super.mods().equal(.{}));
+    try testing.expect(!LinkUrlModifier.super.mods().equal(.{ .ctrl = true }));
+    try testing.expect(!LinkUrlModifier.super.mods().equal(.{ .super = true, .shift = true }));
+}
+
+test "link-url-modifier parsing and updated configuration" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var cfg = try Config.default(alloc);
+    defer cfg.deinit();
+
+    // Re-finalizing with a new setting must refresh the matcher, rather than
+    // retaining the modifier captured when defaults were constructed.
+    inline for (.{ "super", "ctrl", "platform" }) |value| {
+        var it: TestIterator = .{ .data = &.{"--link-url-modifier=" ++ value} };
+        try cfg.loadIter(alloc, &it);
+        try cfg.finalize();
+        const expected = @field(LinkUrlModifier, value);
+        try testing.expectEqual(expected, cfg.@"link-url-modifier");
+        try testing.expect(cfg.link.links.items[0].highlight.hover_mods.equal(expected.mods()));
+    }
+}
+
+test "link-url-modifier with detected URLs disabled" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var cfg = try Config.default(alloc);
+    defer cfg.deinit();
+    var it: TestIterator = .{ .data = &.{
+        "--link-url=false",
+        "--link-url-modifier=super",
+    } };
+    try cfg.loadIter(alloc, &it);
+    try cfg.finalize();
+    try testing.expectEqual(@as(usize, 0), cfg.link.links.items.len);
+    // OSC 8 links still use the chosen modifier independently of the matcher.
+    try testing.expect(cfg.@"link-url-modifier".mods().equal(.{ .super = true }));
+}
