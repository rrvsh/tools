+/// tab bar. Must run on the app's AX thread.
+private func nativeTabButtons(ofWindow window: AXUIElement, _ job: RunLoopJob) throws -> [AXUIElement] {
+    var queue: [(el: AXUIElement, depth: Int)] = [(window, 0)]
+    var looseButtons: [AXUIElement] = [] // fallback for apps that expose buttons without an enclosing AXTabGroup
+    var visited = 0
+    while !queue.isEmpty {
+        try job.checkCancellation()
+        let (el, depth) = queue.removeFirst()
+        for child in el.get(Ax.childrenAttr) ?? [] {
+            visited += 1
+            if visited > nativeTabBarNodeBudget { return looseButtons }
+            // Read the role first (always present, one IPC) and only pay for the subrole on button-ish elements.
+            let role = child.get(Ax.roleAttr)
