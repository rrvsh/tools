+/// The tab buttons of an already-located `AXTabGroup`. They are normally its direct children, but a level or two of
+/// wrapper (scroll area / group) is tolerated.
+private func nativeTabButtons(insideTabGroup group: AXUIElement, _ job: RunLoopJob) throws -> [AXUIElement] {
+    var queue: [(el: AXUIElement, depth: Int)] = [(group, 0)]
+    var buttons: [AXUIElement] = []
+    var visited = 0
+    while !queue.isEmpty {
+        try job.checkCancellation()
+        let (el, depth) = queue.removeFirst()
+        for child in el.get(Ax.childrenAttr) ?? [] {
+            visited += 1
+            if visited > nativeTabGroupNodeBudget { return buttons }
+            if child.get(Ax.subroleAttr) == "AXTabButton" { buttons.append(child); continue }
+            if depth + 1 < nativeTabGroupMaxDepth { queue.append((child, depth + 1)) }
+        }
+    }
