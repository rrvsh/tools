index 0000000..c974aed
--- /dev/null
+++ b/Sources/AppBundle/normalizeNativeTabs.swift
@@ -0,0 +1,166 @@
+import Common
+
+/// Reconcile macOS native window tabs (https://github.com/nikitabobko/AeroSpace/issues/68).
+///
+/// macOS "Merge All Windows" keeps every tab as a separate AX window. Left alone, AeroSpace tiles each tab as its own
+/// slot, which fights the OS and produces empty tiles. Instead a tab group occupies a SINGLE tile: exactly one member
+/// — the currently active (front) tab — is tiled there, and every other tab is parked in the global
+/// `macosTabbedWindowsContainer` (hidden behind the front tab, never given a slot, never floated). Switching tabs
+/// natively makes a different member the front tab; the next refresh re-points that one tile to it. The tile position
+/// is preserved across switches so the group stays put.
+///
+/// Two invariants make this safe:
+/// - **Only the front tab is ever framed.** Framing a background tab tears it out of the group, so background tabs are
+///   parked (and parked windows are a layout no-op).
+/// - **Stateless and fail-safe toward tiling.** Recomputed from the live tab bar every refresh (tolerates macOS
+///   reassigning tab ids), and it releases a parked window the moment it stops being a confirmed background tab, back
+///   to the kind of parent it had (so a member the user had floated returns to floating). Worst case is plain tiling.
+///   Note the representative is never taken away from the user: if it is floating it stays floating and gets no tile.
+@MainActor
+func normalizeNativeTabs() async throws {
+    // Skip while the left mouse button is down. Refreshes fire on every mouse-move AX notification, so reconciling here
+    // would run the AX scan dozens of times per second during a drag — and a drag is exactly when tab membership is in
+    // flux (macOS tab tear-out). The mouse-up refresh (.globalObserverLeftMouseUp) reconciles right after.
+    if isLeftMouseButtonDown { return }
+
+    // Detection is AX I/O on each app's own thread, so run the apps concurrently instead of serially — same shape as
+    // MacApp.refreshAllAndGetAliveWindowIds. Only the pid crosses the task boundary; the app is looked up back here.
+    let detections: [(Int32, NativeTabDetection)] = try await withThrowingTaskGroup(
+        of: (Int32, NativeTabDetection).self,
+        returning: [(Int32, NativeTabDetection)].self,
+    ) { group in
+        for pid in MacApp.allAppsMap.keys {
+            group.addTask { @Sendable @MainActor in
+                guard let app = MacApp.allAppsMap[pid] else { return (pid, NativeTabDetection(clusters: [], appHasTabBar: false)) }
+                return (pid, try await app.detectNativeTabGroups(.cancellable))
+            }
+        }
+        var result: [(Int32, NativeTabDetection)] = []
+        for try await it in group { result.append(it) }
+        return result
+    }
+
+    var shouldBeParked: Set<UInt32> = []
+    var appsWithTabBar: Set<Int32> = []
+    // Reconcile in pid order, not in task-completion order, so the resulting tree doesn't depend on AX timing.
+    for (pid, detection) in detections.sorted(by: { $0.0 < $1.0 }) {
+        if detection.appHasTabBar { appsWithTabBar.insert(pid) }
+        for cluster in detection.clusters {
+            let members = cluster.memberIds.compactMap { Window.get(byId: $0) }
+            try await reconcileNativeTabGroup(members: members, activeId: cluster.mainMemberId, into: &shouldBeParked)
+        }
+    }
+    try await releaseStaleParkedTabs(keeping: shouldBeParked, appsWithTabBar: appsWithTabBar, fallbackWorkspace: focus.workspace)
+}
+
+/// Collapse one detected tab group onto a SINGLE tile: keep the representative (the active/front tab) tiled and park
+/// every other member. Pure tree manipulation (no AX), so it is unit-testable. Adds parked window ids to `shouldBeParked`.
+@MainActor
+func reconcileNativeTabGroup(members rawMembers: [Window], activeId: UInt32?, into shouldBeParked: inout Set<UInt32>) async throws {
+    if rawMembers.count < 2 { return }
+
+    let active = activeId.flatMap { id in rawMembers.first { $0.windowId == id } }
+    // The group lives on the front tab's workspace (else the first tiled member's). Scope membership to it: a real
+    // background tab is a sibling of the front tab on the SAME workspace, so never pull in a same-app window that is
+    // tiled/floating on a DIFFERENT workspace (a cross-workspace title collision). Parked members have no workspace and
+    // are assumed to belong to this group.
+    let groupWorkspace = active?.nodeWorkspace ?? rawMembers.lazy.filter(\.isTiledWindow).compactMap(\.nodeWorkspace).first
+    let members = groupWorkspace == nil
+        ? rawMembers
+        : rawMembers.filter { $0.nodeWorkspace == nil || $0.nodeWorkspace === groupWorkspace }
+    if members.count < 2 { return }
+
+    let tiledMembers = members.filter(\.isTiledWindow)
+
+    // The representative is the single member that occupies the group's one tile. Prefer the active (front) tab so the
+    // tile shows the current tab and only the front tab is ever framed. If nothing is active (the app isn't frontmost),
+    // keep whichever member is already tiled to avoid churn. Respect user-floated members.
+    guard let representative = active ?? tiledMembers.first ?? members.first(where: \.isParkedNativeTab) else { return }
+
+    // Capture the group's existing tile position (held by a tiled non-representative) BEFORE parking, so the group
+    // stays in place when the front tab — and thus the representative — changes on a tab switch.
+    let anchor = tiledMembers.first { $0 !== representative }
+    let slotParent = anchor?.parent as? TilingContainer
+    let slotIndex = anchor?.ownIndex
+
+    // Park every member except the representative: hidden tabs, never framed, never floated.
+    for member in members where member !== representative {
+        parkAsNativeTab(member)
+        shouldBeParked.insert(member.windowId)
+    }
+
+    // Ensure the representative occupies the group's one tile. If it is already tiled (steady state / first
+    // formation) leave it; if the user floated it, respect that. Only a parked representative needs (re)placing —
+    // into the group's slot if one survives, otherwise a fresh tile.
+    if representative.isTiledWindow || representative.isFloating {
+        // nothing to do
+    } else if let slotParent, let slotIndex {
+        representative.layoutReason = .standard
+        representative.bind(to: slotParent, adaptiveWeight: WEIGHT_AUTO, index: min(slotIndex, slotParent.children.count))
+    } else if representative.isParkedNativeTab {
+        try await releaseFromNativeTab(representative, fallbackWorkspace: groupWorkspace ?? focus.workspace)
+    }
+}
+
+/// Per-parked-window count of consecutive refreshes in which it was NOT confirmed as a background tab. Used to debounce
+/// release so a one-refresh title/label flicker (animated titles, "— Edited") doesn't eject and re-tile a real tab.
+@MainActor var nativeTabReleaseMisses: [UInt32: Int] = [:]
+private let nativeTabReleaseGrace = 2
+
+/// Release any parked tab that has stopped being a confirmed background tab, returning it to tiling. Anything in
+/// `keeping` stays. The grace counter (debounce) is applied ONLY while the window's app still has a tab bar
+/// (`appsWithTabBar`) — that's the transient title-flicker case. If the group is gone (its front tab was closed → no
+/// bar), release immediately so the tile freed by the closed tab is refilled in the same refresh (no flicker).
+@MainActor
+func releaseStaleParkedTabs(keeping: Set<UInt32>, appsWithTabBar: Set<Int32>, fallbackWorkspace: Workspace) async throws {
+    for window in macosTabbedWindowsContainer.children.filterIsInstance(of: Window.self) {
+        if keeping.contains(window.windowId) {
+            nativeTabReleaseMisses[window.windowId] = nil // still a tab; reset the grace counter
+            continue
+        }
+        if appsWithTabBar.contains(window.app.pid) {
+            let misses = (nativeTabReleaseMisses[window.windowId] ?? 0) + 1
+            if misses < nativeTabReleaseGrace {
+                nativeTabReleaseMisses[window.windowId] = misses // grace period — likely a transient title flicker
+                continue
+            }
+        }
+        nativeTabReleaseMisses[window.windowId] = nil
+        try await releaseFromNativeTab(window, fallbackWorkspace: fallbackWorkspace)
+    }
+}
+
+extension Window {
+    var isTiledWindow: Bool {
+        if case .tilingContainer = windowParentCases { true } else { false }
+    }
+    var isParkedNativeTab: Bool {
+        if case .macosTabbedWindowsContainer = windowParentCases { true } else { false }
+    }
+}
+
+@MainActor
+func parkAsNativeTab(_ window: Window) {
+    guard let parent = window.parent, parent !== macosTabbedWindowsContainer else { return }
+    // Capture the origin workspace now — a parked window has no workspace, so we can't read it back at release time.
+    window.layoutReason = .nativeTab(prevParentKind: parent.kind, prevWorkspace: window.nodeWorkspace?.name)
+    window.bind(to: macosTabbedWindowsContainer, adaptiveWeight: WEIGHT_DOESNT_MATTER, index: INDEX_BIND_LAST)
+}
+
+@MainActor
+private func releaseFromNativeTab(_ window: Window, fallbackWorkspace: Workspace) async throws {
+    let (prevParentKind, prevWorkspace): (NonLeafTreeNodeKind, String?) =
+        if case .nativeTab(let kind, let ws) = window.layoutReason { (kind, ws) } else { (.tilingContainer, nil) }
+    // Return the window to its origin workspace (captured at park time), not whatever workspace currently has focus.
+    let workspace = prevWorkspace.map { Workspace.get(byName: $0) } ?? fallbackWorkspace
+    window.layoutReason = .standard
+    switch prevParentKind {
+        case .floatingWindowsContainer:
+            window.bindAsFloatingWindow(to: workspace)
+        case .tilingContainer, .workspace:
+            try await window.relayoutWindow(on: workspace, .cancellable, forceTile: true)
+        case .macosMinimizedWindowsContainer, .macosFullscreenWindowsContainer,
+             .macosHiddenAppsWindowsContainer, .macosPopupWindowsContainer, .macosTabbedWindowsContainer:
+            try await window.relayoutWindow(on: workspace, .cancellable)
+    }
+}
diff --git a/Sources/AppBundle/tree/MacApp.swift b/Sources/AppBundle/tree/MacApp.swift
index 66e7189..498a09b 100644
--- a/Sources/AppBundle/tree/MacApp.swift
+++ b/Sources/AppBundle/tree/MacApp.swift
@@ -1,6 +1,140 @@
 import AppKit
 import Common

+/// A detected macOS native window tab group (issue #68). `memberIds` are all windows of the group;
+/// `mainMemberId` is the front tab (the one that exposes the tab bar / is `kAXMain`).
+struct NativeTabCluster: Sendable {
+    let memberIds: [UInt32]
+    let mainMemberId: UInt32?
+}
+
+/// Result of scanning one app for native tab groups. `appHasTabBar` is true when ANY window of the app exposes a
+/// multi-tab bar — i.e. a tab group still exists even if no cluster formed this pass (a transient title-label flicker).
+/// It distinguishes "the group is still there, a member just didn't match" from "the group is gone (tab closed)".
+struct NativeTabDetection: Sendable {
+    let clusters: [NativeTabCluster]
+    let appHasTabBar: Bool
+}
+
+/// How well a window's title corresponds to a tab-bar label, or `nil` for no match. Only the front tab exposes the tab
