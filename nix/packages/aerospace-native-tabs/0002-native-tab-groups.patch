+/// window read), group the members of each tab group. A non-front member must be HIDDEN (not in `freshIds`) — that is
+/// what distinguishes a real background tab from a separate, visible same-title window. Each tab label occurrence is
+/// assigned to a distinct best-matching window, so a group never has more windows than tabs and duplicate labels still
+/// map to separate windows.
+func nativeTabClusters(titleById: [UInt32: String], tabBarById: [UInt32: [String]], freshIds: Set<UInt32>) -> [NativeTabCluster] {
+    var clusters: [NativeTabCluster] = []
+    var claimed = Set<UInt32>()
+    for frontId in tabBarById.keys.sorted() where !claimed.contains(frontId) {
+        guard let labels = tabBarById[frontId] else { continue }
