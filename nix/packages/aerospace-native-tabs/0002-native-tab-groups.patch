+                // real background tab. This excludes separate visible windows that merely share a title (terminals), and
+                // never lets one group's bar claim another group's front tab.
+                .filter { !used.contains($0) && ($0 == frontId || (tabBarById[$0] == nil && !freshIds.contains($0))) }
