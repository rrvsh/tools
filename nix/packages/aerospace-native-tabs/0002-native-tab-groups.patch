+/// which windows exist, which of them are hidden, and their titles — so the very common refresh that changes none of
+/// them reuses the previous scan instead of re-walking AX. Any change self-heals on the next refresh.
+private struct NativeTabScanCache {
+    var signature: String = ""
+    var tabBarById: [UInt32: [String]] = [:]
