@@ -0,0 +1,212 @@
+@testable import AppBundle
+import XCTest
+
+@MainActor
+final class NativeTabsTest: XCTestCase {
+    override func setUp() async throws {
+        setUpWorkspacesForTests()
+        // The tab park container + release-grace counter are global singletons; clear leftovers from other tests.
+        for child in macosTabbedWindowsContainer.children { child.unbindFromParent() }
+        nativeTabReleaseMisses = [:]
+    }
+
+    /// A tab group must collapse onto a SINGLE tile: the active (front) tab is tiled, every other tab is parked
+    /// (hidden, not floated, not a separate slot). Switching the active tab must keep the group in the same slot.
+    /// Un-merging must release the parked tab back to tiling.
+    func testTabGroupOccupiesOneTile_switchPreservesSlot_unmergeReleases() async throws {
+        let workspace = Workspace.get(byName: name)
+        let root = workspace.rootTilingContainer
+
+        // A normal neighbor window plus a 2-tab group whose members both start tiled (the #68 bug we fix).
+        let neighbor = TestWindow.new(id: 1, parent: root)
+        let tabA = TestWindow.new(id: 2, parent: root)
+        let tabB = TestWindow.new(id: 3, parent: root)
+        XCTAssertEqual(root.children.count, 3)
+
+        // --- Form the group: A is the active/front tab ---
+        var parked: Set<UInt32> = []
+        try await reconcileNativeTabGroup(members: [tabA, tabB], activeId: tabA.windowId, into: &parked)
+
+        XCTAssertTrue(tabA.isTiledWindow, "active tab is the one tile")
+        XCTAssertTrue(tabB.isParkedNativeTab, "background tab is parked")
+        XCTAssertTrue(neighbor.isTiledWindow, "unrelated window is untouched")
+        XCTAssertEqual(root.children.count, 2, "the group is one tile next to the neighbor")
+        XCTAssertEqual(parked, [tabB.windowId])
+        let slotIndex = tabA.ownIndex
+
+        // --- Switch tab: B becomes the active/front tab (A recedes to background) ---
+        parked = []
+        try await reconcileNativeTabGroup(members: [tabA, tabB], activeId: tabB.windowId, into: &parked)
+
+        XCTAssertTrue(tabB.isTiledWindow, "after switch, the now-active tab holds the tile")
+        XCTAssertTrue(tabA.isParkedNativeTab, "the previously-active tab is now parked")
+        XCTAssertEqual(tabB.ownIndex, slotIndex, "the group stays in the same tiling slot across a tab switch")
+        XCTAssertEqual(root.children.count, 2)
+        XCTAssertEqual(parked, [tabA.windowId])
+
+        // --- Un-merge: the group is gone (no app tab bar), so the parked tab is released immediately ---
+        try await releaseStaleParkedTabs(keeping: [], appsWithTabBar: [], fallbackWorkspace: workspace)
+        XCTAssertTrue(tabA.isTiledWindow, "un-merged tab returns to tiling immediately once the group is gone")
+        XCTAssertTrue(tabB.isTiledWindow)
+        XCTAssertEqual(root.children.count, 3, "both tabs and the neighbor are tiled again")
+        XCTAssertTrue(macosTabbedWindowsContainer.children.isEmpty)
+    }
+
+    /// Detection must group tabs even when the tab-button label is only a substring of the window title.
+    /// Regression for Sequel Ace: window titles are "(MySQL <ver>) host/db/db", tab labels are "host/db/db".
+    func testDetectionMatchesSubstringTabLabels() {
+        let titleById: [UInt32: String] = [
+            15251: "(MySQL 8.0.46-0ubuntu0.24.04.2) 100.114.137.126/777fy/777fy",
+            15317: "(MySQL 8.0.45) localhost/777fy/777fy",
+        ]
+        // Only the front tab (15251) exposes the bar; it lists both connection labels.
+        let tabBarById: [UInt32: [String]] = [
+            15251: ["100.114.137.126/777fy/777fy", "localhost/777fy/777fy"],
+        ]
+        let clusters = nativeTabClusters(titleById: titleById, tabBarById: tabBarById, freshIds: [15251]) // 15317 is the hidden background tab
+        XCTAssertEqual(clusters.count, 1)
+        XCTAssertEqual(Set(clusters[0].memberIds), [15251, 15317])
+        XCTAssertEqual(clusters[0].mainMemberId, 15251)
+    }
+
+    /// Detection must not group an unrelated window of the same app that doesn't match the tab roster, and a lone
+    /// front tab (no matching siblings) is not a group.
+    func testDetectionDoesNotOvergroup() {
+        let titleById: [UInt32: String] = [
+            1: "(MySQL 8.0) host-a/db/db",
+            2: "Some Unrelated Window",
+        ]
+        let tabBarById: [UInt32: [String]] = [1: ["host-a/db/db", "host-b/db/db"]]
+        // host-b is not open as a window, and window 2 doesn't match → no group of >= 2.
+        XCTAssertTrue(nativeTabClusters(titleById: titleById, tabBarById: tabBarById, freshIds: [1, 2]).isEmpty)
+    }
+
+    /// While the group still exists (app still has a tab bar) a momentary drop from the cluster (title-label flicker)
+    /// is debounced; but once the group is gone the tab is released at once (covered by the un-merge test above).
+    func testReleaseDebouncedOnlyWhileGroupStillExists() async throws {
+        let workspace = Workspace.get(byName: name)
+        let tabA = TestWindow.new(id: 1, parent: workspace.rootTilingContainer)
+        let tabB = TestWindow.new(id: 2, parent: workspace.rootTilingContainer)
+        var parked: Set<UInt32> = []
+        try await reconcileNativeTabGroup(members: [tabA, tabB], activeId: tabA.windowId, into: &parked)
+        XCTAssertTrue(tabB.isParkedNativeTab)
+
+        let pid = tabB.app.pid // the app still exposes a tab bar
+        try await releaseStaleParkedTabs(keeping: [], appsWithTabBar: [pid], fallbackWorkspace: workspace)
+        XCTAssertTrue(tabB.isParkedNativeTab, "debounced while the group still exists (likely a title flicker)")
+        try await releaseStaleParkedTabs(keeping: [], appsWithTabBar: [pid], fallbackWorkspace: workspace)
+        XCTAssertTrue(tabB.isTiledWindow, "released after the grace period")
+    }
+
+    /// An unrelated same-app window whose title merely COLLIDES with a tab label must not be grabbed: each label is
+    /// assigned to its single best match, and matching only happens at the start/end of the title.
+    func testDetectionDoesNotGrabCollidingSameAppWindow() {
+        let titleById: [UInt32: String] = [
+            1: "Untitled",            // real front tab
+            2: "Untitled 2",          // real second tab
+            3: "Untitled Document",   // unrelated standalone window that merely starts with "Untitled"
+        ]
+        let tabBarById: [UInt32: [String]] = [1: ["Untitled", "Untitled 2"]]
+        let clusters = nativeTabClusters(titleById: titleById, tabBarById: tabBarById, freshIds: [1, 3]) // 2 is the hidden tab; 3 is a separate visible window
+        XCTAssertEqual(clusters.count, 1)
+        // "Untitled" is assigned to the exact match (1), not the prefix-colliding "Untitled Document" (3).
+        XCTAssertEqual(Set(clusters[0].memberIds), [1, 2])
+        XCTAssertFalse(clusters[0].memberIds.contains(3))
+    }
+
+    /// Two separate tab groups of the SAME app that share a label must not steal each other's front tab.
+    func testTwoSameAppGroupsDoNotStealEachOthersFront() {
+        // Group A: front 1 ("A1", bar [A1,A2]) + member 2 ("A2"). Group B: front 3 ("A2", bar [A2,B2]) + member 4 ("B2").
+        // Front 3's title collides with group A's label "A2"; A must not claim front 3.
+        let titleById: [UInt32: String] = [1: "A1", 2: "A2", 3: "A2", 4: "B2"]
+        let tabBarById: [UInt32: [String]] = [1: ["A1", "A2"], 3: ["A2", "B2"]]
+        let clusters = nativeTabClusters(titleById: titleById, tabBarById: tabBarById, freshIds: [1, 3]) // fronts visible; bg tabs 2,4 hidden
+        let sets = clusters.map { Set($0.memberIds) }
+        XCTAssertEqual(clusters.count, 2)
+        XCTAssertTrue(sets.contains([1, 2]), "group A is {1,2}")
+        XCTAssertTrue(sets.contains([3, 4]), "group B keeps its own front tab: {3,4}")
+    }
+
+    /// Reconciliation must not pull in a same-app window that lives on a DIFFERENT workspace (cross-workspace collision).
+    func testReconcileLeavesCrossWorkspaceWindowAlone() async throws {
+        let wsA = Workspace.get(byName: name)
+        let tabA = TestWindow.new(id: 1, parent: wsA.rootTilingContainer)
+        let tabB = TestWindow.new(id: 2, parent: wsA.rootTilingContainer)
+        let wsB = Workspace.get(byName: name + "-B")
+        let stranger = TestWindow.new(id: 3, parent: wsB.rootTilingContainer)
+
+        var parked: Set<UInt32> = []
+        try await reconcileNativeTabGroup(members: [tabA, tabB, stranger], activeId: tabA.windowId, into: &parked)
+        XCTAssertTrue(tabA.isTiledWindow)
+        XCTAssertTrue(tabB.isParkedNativeTab)
+        XCTAssertTrue(stranger.isTiledWindow, "a same-app window on another workspace is not pulled into the group")
+        XCTAssertFalse(parked.contains(stranger.windowId))
+    }
+
+    /// A released tab returns to its ORIGIN workspace, not whatever workspace currently has focus.
+    func testReleasedTabReturnsToOriginWorkspace() async throws {
+        let wsA = Workspace.get(byName: name)
+        let tabA = TestWindow.new(id: 1, parent: wsA.rootTilingContainer)
+        let tabB = TestWindow.new(id: 2, parent: wsA.rootTilingContainer)
+
+        var parked: Set<UInt32> = []
+        try await reconcileNativeTabGroup(members: [tabA, tabB], activeId: tabA.windowId, into: &parked)
+        XCTAssertTrue(tabB.isParkedNativeTab)
+
+        // Focus a different workspace, then release the stale parked tab (group gone → immediate release).
+        let wsB = Workspace.get(byName: name + "-B")
+        _ = wsB.focusWorkspace()
+        try await releaseStaleParkedTabs(keeping: [], appsWithTabBar: [], fallbackWorkspace: wsB)
+        XCTAssertTrue(tabB.isTiledWindow)
+        XCTAssertEqual(tabB.nodeWorkspace?.name, wsA.name, "released tab returns to its origin workspace, not the focused one")
+    }
+
+    /// Two tabs with the SAME title must still be grouped (each duplicate label maps to a distinct window).
+    func testDetectionGroupsDuplicateTabLabels() {
+        let titleById: [UInt32: String] = [1: "Untitled", 2: "Untitled"]
+        let tabBarById: [UInt32: [String]] = [1: ["Untitled", "Untitled"]]
+        let clusters = nativeTabClusters(titleById: titleById, tabBarById: tabBarById, freshIds: [1]) // 2 is the hidden background tab
+        XCTAssertEqual(clusters.count, 1)
+        XCTAssertEqual(Set(clusters[0].memberIds), [1, 2])
+    }
+
+    /// A separate VISIBLE window that shares a title with a tab (terminals reuse the shell path) must not be grouped.
+    /// Regression for Ghostty: several windows titled "luhw@host:~/Projects" were all lumped into one group.
+    func testHiddenSignalExcludesSeparateSameTitleWindow() {
+        let titleById: [UInt32: String] = [1: "term", 2: "term", 3: "term"]
+        let tabBarById: [UInt32: [String]] = [1: ["term", "term"]]
+        // Front 1 and the standalone window 3 are visible; only the real background tab 2 is hidden.
+        let clusters = nativeTabClusters(titleById: titleById, tabBarById: tabBarById, freshIds: [1, 3])
+        XCTAssertEqual(clusters.count, 1)
+        XCTAssertEqual(Set(clusters[0].memberIds), [1, 2])
+        XCTAssertFalse(clusters[0].memberIds.contains(3), "the separate visible same-title window is not grouped")
+    }
+
+    /// A label appearing only in the MIDDLE of an unrelated title is never a match.
+    func testDetectionIgnoresMiddleOfTitleMatches() {
+        // Window 2's title contains "report" in the middle but doesn't start or end with the tab label.
+        let titleById: [UInt32: String] = [1: "report", 2: "my report draft"]
+        let tabBarById: [UInt32: [String]] = [1: ["report", "summary"]]
+        XCTAssertTrue(nativeTabClusters(titleById: titleById, tabBarById: tabBarById, freshIds: [1, 2]).isEmpty)
+    }
+
+    /// A window the user floated must never be pulled into the tile, and a single-window "group" is a no-op.
+    func testRespectsFloatingAndIgnoresSingletons() async throws {
+        let workspace = Workspace.get(byName: name)
+        let root = workspace.rootTilingContainer
+        let floated = TestWindow.new(id: 10, parent: root)
+        floated.bindAsFloatingWindow(to: workspace)
+        let tiled = TestWindow.new(id: 11, parent: root)
+
+        var parked: Set<UInt32> = []
+        // Group of one → nothing to do.
+        try await reconcileNativeTabGroup(members: [tiled], activeId: tiled.windowId, into: &parked)
+        XCTAssertTrue(tiled.isTiledWindow)
+        XCTAssertTrue(parked.isEmpty)
+
+        // Active member is user-floated → it stays floating; the other is still parked (no extra tile, no float-stealing).
+        try await reconcileNativeTabGroup(members: [floated, tiled], activeId: floated.windowId, into: &parked)
+        XCTAssertTrue(floated.isFloating, "user-floated active tab is left floating")
+        XCTAssertTrue(tiled.isParkedNativeTab)
+    }
+}
