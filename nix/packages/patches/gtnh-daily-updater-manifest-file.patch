+func loadAndLogManifestFile(path string) (*manifest.DailyManifest, error) {
+	logging.Infof("Loading pinned manifest %s...\n", path)
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("reading manifest file: %w", err)
+	}
+
+	var m manifest.DailyManifest
+	if err := json.Unmarshal(data, &m); err != nil {
+		return nil, fmt.Errorf("parsing manifest file: %w", err)
+	}
+
+	logging.Debugf(
+		"Verbose: loaded pinned manifest version=%s updated=%s config=%s github-mods=%d external-mods=%d\n",
+		m.Version,
+		m.LastUpdated,
+		m.Config,
+		len(m.GithubMods),
+		len(m.ExternalMods),
+	)
+	return &m, nil
+}
