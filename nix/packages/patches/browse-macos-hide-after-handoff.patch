+
+#[cfg(target_os = "macos")]
+fn macos_handoff_app() -> Option<String> {
+    std::env::var(MACOS_HANDOFF_APP).ok().map(|app| app.trim().to_string()).filter(|app| !app.is_empty())
+}
+
+#[cfg(not(target_os = "macos"))]
+fn macos_handoff_app() -> Option<String> {
+    None
+}
+
+#[cfg(target_os = "macos")]
+async fn macos_app_visible(app: &str) -> anyhow::Result<bool> {
+    let output = Command::new("/usr/bin/osascript")
+        .args([
+            "-e",
+            "on run argv",
+            "-e",
+            "tell application \"System Events\" to get visible of process (item 1 of argv)",
+            "-e",
+            "end run",
+            app,
+        ])
+        .output()
+        .await?;
+    if !output.status.success() {
+        return Err(anyhow!(String::from_utf8_lossy(&output.stderr).trim().to_string()));
+    }
+    match String::from_utf8_lossy(&output.stdout).trim() {
+        "true" => Ok(true),
+        "false" => Ok(false),
+        value => Err(anyhow!("unexpected visibility result: {value}")),
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+async fn macos_app_visible(_app: &str) -> anyhow::Result<bool> {
+    Ok(true)
+}
+
+#[cfg(target_os = "macos")]
+async fn hide_macos_app(app: &str) -> anyhow::Result<()> {
+    let output = Command::new("/usr/bin/osascript")
+        .args([
+            "-e",
+            "on run argv",
+            "-e",
+            "tell application \"System Events\" to set visible of process (item 1 of argv) to false",
+            "-e",
+            "end run",
+            app,
+        ])
+        .output()
+        .await?;
+    if !output.status.success() {
+        return Err(anyhow!(String::from_utf8_lossy(&output.stderr).trim().to_string()));
+    }
+    Ok(())
+}
+
+#[cfg(not(target_os = "macos"))]
+async fn hide_macos_app(_app: &str) -> anyhow::Result<()> {
+    Ok(())
+}
 
