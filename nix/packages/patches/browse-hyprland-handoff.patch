+#[cfg(target_os = "linux")]
+const HYPRLAND_HANDOFF_WORKSPACE: &str = "OPENCODE_BROWSER_HYPRLAND_HANDOFF_WORKSPACE";
+
+#[cfg(target_os = "linux")]
+fn hyprland_handoff_workspace() -> Option<String> {
+    std::env::var(HYPRLAND_HANDOFF_WORKSPACE)
+        .ok()
+        .map(|workspace| workspace.trim().to_string())
+        .filter(|workspace| {
+            !workspace.is_empty()
+                && workspace.chars().all(|char| char.is_ascii_alphanumeric() || matches!(char, '-' | '_'))
+        })
+}
+
+#[cfg(not(target_os = "linux"))]
+fn hyprland_handoff_workspace() -> Option<String> {
+    None
+}
+
+#[cfg(target_os = "linux")]
+async fn hyprland_workspace_visible(workspace: &str) -> anyhow::Result<bool> {
+    let output = Command::new("hyprctl").args(["--instance", "0", "monitors", "-j"]).output().await?;
+    if !output.status.success() {
+        return Err(anyhow!(
+            "hyprctl monitors failed: {}{}",
+            String::from_utf8_lossy(&output.stdout).trim(),
+            String::from_utf8_lossy(&output.stderr).trim()
+        ));
+    }
+    let monitors: Value = serde_json::from_slice(&output.stdout)?;
+    let target = format!("special:{workspace}");
+    Ok(monitors.as_array().is_some_and(|monitors| {
+        monitors.iter().any(|monitor| monitor.pointer("/specialWorkspace/name").and_then(Value::as_str) == Some(&target))
+    }))
+}
+
+#[cfg(not(target_os = "linux"))]
+async fn hyprland_workspace_visible(_workspace: &str) -> anyhow::Result<bool> {
+    Ok(true)
+}
+
+#[cfg(target_os = "linux")]
+async fn toggle_hyprland_workspace(workspace: &str) -> anyhow::Result<()> {
+    let script = format!(r#"hl.dispatch(hl.dsp.workspace.toggle_special("{workspace}"))"#);
+    let output = Command::new("hyprctl").args(["--instance", "0", "eval", &script]).output().await?;
+    if !output.status.success() {
+        return Err(anyhow!(
+            "hyprctl toggle failed: {}{}",
+            String::from_utf8_lossy(&output.stdout).trim(),
+            String::from_utf8_lossy(&output.stderr).trim()
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(not(target_os = "linux"))]
+async fn toggle_hyprland_workspace(_workspace: &str) -> anyhow::Result<()> {
+    Ok(())
+}
+
+#[cfg(target_os = "linux")]
+async fn hide_hyprland_workspace(workspace: &str) -> anyhow::Result<()> {
+    if hyprland_workspace_visible(workspace).await? {
+        toggle_hyprland_workspace(workspace).await?;
+    }
+    Ok(())
+}
+
+#[cfg(not(target_os = "linux"))]
+async fn hide_hyprland_workspace(_workspace: &str) -> anyhow::Result<()> {
+    Ok(())
+}
