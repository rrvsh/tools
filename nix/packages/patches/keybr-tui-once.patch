diff --git a/src/update.rs b/src/update.rs
index 2412cb9..b62ad33 100644
--- a/src/update.rs
+++ b/src/update.rs
@@ -835,0 +836,25 @@ fn finishing_lesson_does_not_require_extra_keystroke() {
+    #[test]
+    fn once_mode_exits_after_finishing_one_lesson() {
+        let mut app = make_test_app("a");
+        app.exit_after_lesson = true;
+
+        update(&mut app, AppEvent::Key(make_key(KeyCode::Char('a'))));
+
+        assert!(!app.running);
+        assert!(app.completed_lesson_this_run);
+        assert!(app.last_lesson.is_some());
+        assert!(app.pending_stats_save);
+    }
+
+    #[test]
+    fn normal_mode_continues_after_finishing_a_lesson() {
+        let mut app = make_test_app("a");
+
+        update(&mut app, AppEvent::Key(make_key(KeyCode::Char('a'))));
+
+        assert!(app.running);
+        assert!(app.completed_lesson_this_run);
+        assert_eq!(app.screen, AppScreen::Typing);
+        assert_eq!(app.cursor_pos, 0);
+    }
+
