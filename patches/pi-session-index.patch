+import { spawn } from "child_process";
@@ -940,0 +942,58 @@ function buildSessionInfosWithConcurrency(
+interface IndexedSessionInfo extends Omit<SessionInfo, "created" | "modified"> {
+	createdMs: number;
+	modifiedMs: number;
+}
+
+async function listAllSessionsFromIndex(
+	onProgress?: SessionListProgress,
+	signal?: AbortSignal,
+): Promise<SessionInfo[] | null> {
+	const executable = process.env.PI_SESSION_INDEX_BIN ?? "pi-session-index";
+	const cachePath =
+		process.env.PI_SESSION_INDEX_CACHE ?? join(getDefaultAgentDir(), "cache", "session-index.sqlite3");
+	const child = spawn(
+		executable,
+		["--sessions-dir", getSessionsDir(), "--cache", cachePath, "--output", "ndjson"],
+		{ stdio: ["ignore", "pipe", "pipe"] },
+	);
+	const exited = new Promise<number | null>((resolve, reject) => {
+		child.once("error", reject);
+		child.once("close", resolve);
+	});
+	let stderr = "";
+	child.stderr.setEncoding("utf8");
+	child.stderr.on("data", (chunk: string) => {
+		if (stderr.length < 8192) stderr += chunk.slice(0, 8192 - stderr.length);
+	});
+	const abort = () => child.kill();
+	signal?.addEventListener("abort", abort, { once: true });
+
+	try {
+		const sessions: SessionInfo[] = [];
+		const lines = createInterface({ input: child.stdout, crlfDelay: Infinity });
+		for await (const line of lines) {
+			if (!line) continue;
+			const indexed = JSON.parse(line) as IndexedSessionInfo;
+			const { createdMs, modifiedMs, ...session } = indexed;
+			sessions.push({ ...session, created: new Date(createdMs), modified: new Date(modifiedMs) });
+		}
+		const exitCode = await exited;
+		signal?.throwIfAborted();
+		if (exitCode !== 0) return null;
+		onProgress?.(sessions.length, sessions.length, sessions);
+		return sessions;
+	} catch {
+		signal?.throwIfAborted();
+		if (child.exitCode === null) {
+			child.kill();
+			await exited.catch(() => undefined);
+		}
+		if (stderr && process.env.PI_SESSION_INDEX_DEBUG === "1") {
+			process.stderr.write(`pi-session-index: ${stderr}`);
+		}
+		return null;
+	} finally {
+		signal?.removeEventListener("abort", abort);
+	}
+}
+
@@ -1948,0 +2008,3 @@ export class SessionManager {
