+describe("FooterDataProvider extension statuses", () => {
+	it("tracks alignment without changing the text-only status view", () => {
+		const tempDir = mkdtempSync(join(tmpdir(), "footer-statuses-"));
+		const provider = new FooterDataProvider(tempDir);
+		try {
+			provider.setExtensionStatus("left", "Left");
+			provider.setExtensionStatus("right", "Right", { align: "right" });
+
+			expect(provider.getExtensionStatuses()).toEqual(
+				new Map([
+					["left", "Left"],
+					["right", "Right"],
+				]),
+			);
+			expect(provider.getExtensionStatusAlignments()).toEqual(
+				new Map([
+					["left", "left"],
+					["right", "right"],
+				]),
+			);
+
+			provider.setExtensionStatus("right", "Moved");
+			expect(provider.getExtensionStatusAlignments().get("right")).toBe("left");
+
+			provider.setExtensionStatus("right", undefined);
+			expect(provider.getExtensionStatuses().has("right")).toBe(false);
+			expect(provider.getExtensionStatusAlignments().has("right")).toBe(false);
+
+			provider.clearExtensionStatuses();
+			expect(provider.getExtensionStatuses().size).toBe(0);
+			expect(provider.getExtensionStatusAlignments().size).toBe(0);
+		} finally {
+			provider.dispose();
+			rmSync(tempDir, { recursive: true, force: true });
+		}
+	});
+});
+
