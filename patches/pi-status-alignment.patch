@@ -0,0 +1,35 @@
+import { describe, expect, it } from "vitest";
+import { createSetStatusRequest } from "../src/modes/rpc/rpc-mode.ts";
+
+describe("RPC extension status requests", () => {
+	it("omits alignment when the extension uses the default", () => {
+		expect(createSetStatusRequest("build", "Running", undefined, "request-1")).toEqual({
+			type: "extension_ui_request",
+			id: "request-1",
+			method: "setStatus",
+			statusKey: "build",
+			statusText: "Running",
+		});
+	});
+
+	it("forwards right alignment", () => {
+		expect(createSetStatusRequest("session", "Footer label", { align: "right" }, "request-2")).toEqual({
+			type: "extension_ui_request",
+			id: "request-2",
+			method: "setStatus",
+			statusKey: "session",
+			statusText: "Footer label",
+			statusAlign: "right",
+		});
+	});
+
+	it("preserves clear requests", () => {
+		expect(createSetStatusRequest("session", undefined, { align: "right" }, "request-3")).toEqual({
+			type: "extension_ui_request",
+			id: "request-3",
+			method: "setStatus",
+			statusKey: "session",
+			statusText: undefined,
+		});
+	});
+});
