+import type { ContextUsage, ExtensionStatusAlignment } from "../../../core/extensions/types.ts";
@@ -46,0 +47,35 @@ export function formatCwdForFooter(cwd: string, home: string | undefined): strin
+export function formatExtensionStatusLine(
+	statuses: ReadonlyMap<string, string>,
+	alignments: ReadonlyMap<string, ExtensionStatusAlignment>,
+	width: number,
+): string | undefined {
+	if (statuses.size === 0) return undefined;
+	if (width <= 0) return "";
+
+	const left: string[] = [];
+	const right: string[] = [];
+	for (const [key, text] of Array.from(statuses.entries()).sort(([a], [b]) => a.localeCompare(b))) {
+		const target = alignments.get(key) === "right" ? right : left;
+		target.push(sanitizeStatusText(text));
+	}
+
+	const leftText = left.join(" ");
+	const rightText = right.join(" ");
+	const ellipsis = theme.fg("dim", "...");
+	if (!rightText) return truncateToWidth(leftText, width, ellipsis);
+
+	const renderedRight = truncateToWidth(rightText, width, ellipsis);
+	const rightWidth = visibleWidth(renderedRight);
+	if (!leftText) return " ".repeat(Math.max(0, width - rightWidth)) + renderedRight;
+
+	const availableForLeft = width - rightWidth - 1;
+	if (availableForLeft <= 0) {
+		return " ".repeat(Math.max(0, width - rightWidth)) + renderedRight;
+	}
+
+	const renderedLeft = truncateToWidth(leftText, availableForLeft, ellipsis);
+	const leftWidth = visibleWidth(renderedLeft);
+	const padding = " ".repeat(Math.max(1, width - leftWidth - rightWidth));
+	return renderedLeft + padding + renderedRight;
+}
+
