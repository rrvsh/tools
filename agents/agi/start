#!/usr/bin/env bash
# Supervises one pi process: spawn, watch for silence, restart.
# Turns themselves are scheduled by turn.ts inside the process.
set -uo pipefail

ROOT=${AGI_ROOT:-${HOME}/agi}
STATE=${PI_CODING_AGENT_DIR:?}
INIT=${AGI_INIT:-/etc/agi/init}
LOG=${STATE}/loop.log
SILENCE=600

mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }
notify() { command -v systemd-notify >/dev/null 2>&1 && systemd-notify "$@" 2>/dev/null; return 0; }
note() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >>"$LOG"; }

ensure() {
  mkdir -p "$ROOT/.threads"
  [ -f "$ROOT/SYSTEM.md" ] || cp "$INIT/SYSTEM.md" "$ROOT/SYSTEM.md"
  [ -f "$ROOT/AGENTS.md" ] || cp "$INIT/AGENTS.md" "$ROOT/AGENTS.md"
  [ -n "$(ls -1 "$ROOT/.threads"/agi-seed-*.md 2>/dev/null)" ] ||
    cp "$INIT/seed.md" "$ROOT/.threads/agi-seed-$(date -u +%Y%m%dT%H%M%SZ).md"
  head -n 1 "$ROOT/SYSTEM.md" | grep -q 'full autonomy' ||
    note 'WARNING: SYSTEM.md does not start with the autonomy line'
  ls -1 "$ROOT/.threads"/agi-seed-*.md 2>/dev/null | sort | tail -n 1 >"$STATE/seed-path"
}

trap 'note stopping; kill "$pid" 2>/dev/null; exit 0' TERM INT

ensure
note start
blank=0

while :; do
  args=()
  last=$(ls -1t "$STATE"/sessions/*.jsonl 2>/dev/null | head -n 1)
  [ -n "$last" ] && args+=(--continue)

  cd "$ROOT" || exit 1
  coproc PI {
    pi --mode rpc \
      -ne -e /etc/agi/turn.ts -e /etc/agi/self.ts -e builtin:codemode -ns -np --no-themes \
      --tools codemode,bash \
      --system-prompt "$ROOT/SYSTEM.md" \
      --thinking high --provider venice --model "${AGI_MODEL:-deepseek-v4-1-flash-1017-uncensored}" \
      --session-dir "$STATE/sessions" --name "agi $(date -u +%FT%TZ)" \
      "${args[@]}" 2>>"$STATE/stderr.log"
  }
  pid=$PI_PID
  exec 4<&"${PI[0]}"
  exec 5>&"${PI[1]}"
  note "pid=$pid ${args[*]:-new session}"
  notify --ready

  quiet=0
  while :; do
    if read -r -t 1 line <&4; then
      quiet=0
      notify WATCHDOG=1
    else
      quiet=$((quiet + 1))
      notify WATCHDOG=1
      kill -0 "$pid" 2>/dev/null || { blank=$((blank + 1)); note 'exited'; break; }
      if [ "$quiet" -ge "$SILENCE" ]; then
        note 'silent, killing'
        kill "$pid" 2>/dev/null
        break
      fi
    fi
  done
  [ "$quiet" -ge 60 ] && blank=0

  kill "$pid" 2>/dev/null
  wait "$pid" 2>/dev/null
  [ "$blank" -ge 3 ] && { note 'died before output 3x, turn.ts may be broken'; blank=0; }
  exec 4<&- 5>&-
  note restart
  sleep 3
done
